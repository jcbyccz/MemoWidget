<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TextNote"
        tools:targetApi="31">

        <!-- 主界面 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 长按图标的快捷方式（App Shortcuts） -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 编辑：需 exported="true"，作为静态 shortcut 的目标（系统/launcher 发起启动） -->
        <activity
            android:name=".ui.EditNoteActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- 待办编辑页 -->
        <activity
            android:name=".ui.TodoEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 回收站 -->
        <activity
            android:name=".ui.RecycleBinActivity"
            android:exported="false" />

        <!-- 设置 -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <!-- 桌面小部件 -->
        <receiver
            android:name=".widget.MemoWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/memo_widget_info" />
        </receiver>

        <!-- 小部件滚动数据服务（系统绑定，仅系统可访问） -->
        <service
            android:name=".widget.MemoWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <activity
            android:name=".widget.MemoWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 添加小部件快捷方式入口（引导页：发起系统 pin 请求并显示结果/手动引导） -->
        <activity
            android:name=".widget.PinWidgetActivity"
            android:exported="true"
            android:excludeFromRecents="true" />

    </application>
</manifest>