<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:animateLayoutChanges="true"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="@color/toolbar_text">

        <!-- 右上角确认按钮：保存并退出（最先声明 → 最靠右，与便签页一致） -->
        <ImageView
            android:id="@+id/btn_confirm"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:padding="8dp"
            android:contentDescription="确认保存"
            android:src="@drawable/ic_check"
            app:tint="@color/toolbar_text"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <!-- 重做：恢复被撤销的一次编辑 -->
        <ImageView
            android:id="@+id/btn_redo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:padding="8dp"
            android:contentDescription="重做"
            android:src="@drawable/ic_redo"
            app:tint="@color/toolbar_text"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <!-- 撤销：回退最近一次编辑 -->
        <ImageView
            android:id="@+id/btn_undo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:padding="8dp"
            android:contentDescription="撤销"
            android:src="@drawable/ic_undo"
            app:tint="@color/toolbar_text"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </com.google.android.material.appbar.MaterialToolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="16dp">

            <!-- 题目 -->
            <EditText
                android:id="@+id/ed_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="题目"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:textColorHint="#BDBDBD"
                android:maxLines="2"
                android:inputType="textCapSentences"
                android:background="@null"
                android:padding="4dp" />

            <!-- 未完成条目行容器（代码动态构建） -->
            <LinearLayout
                android:id="@+id/rows_undo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp" />

            <!-- ＋添加目录：点击加一行（文案与参考截图一致） -->
            <TextView
                android:id="@+id/btn_add_item"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="＋ 添加目录"
                android:textColor="#9E9E9E"
                android:textSize="14sp" />

            <!-- 分割线（有已完成条目时才显示） -->
            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="2dp"
                android:visibility="gone" />

            <!-- 已完成区标题行：箭头(折叠) + 标题 + 齿轮 -->
            <LinearLayout
                android:id="@+id/done_header"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btn_done_collapse"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:padding="2dp"
                    android:contentDescription="折叠已完成"
                    android:src="@drawable/ic_arrow_down_small" />

                <TextView
                    android:id="@+id/tv_done_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:text="已完该做的事(0)"
                    android:textColor="#9E9E9E"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/btn_done_gear"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="5dp"
                    android:contentDescription="已完成设置"
                    android:src="@drawable/ic_settings"
                    app:tint="#9E9E9E"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <!-- 已完成条目行容器（代码动态构建） -->
            <LinearLayout
                android:id="@+id/rows_done"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- 待办照片：与便签编辑页同款，编辑区下方竖向排列、每张独占一行、靠左，
                 显示尺寸贴合照片比例（宽=内容区宽，超 500dp 等比缩小），无白框描边；
                 点击进大图浏览，照片右上角 ✕ 快捷删除；无照片时整块隐藏 -->
            <LinearLayout
                android:id="@+id/photo_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="14dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- ===== 底部固定区：最左侧“添加照片”按钮 + 修改时间（右对齐） ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btn_photo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:contentDescription="添加照片"
            android:src="@drawable/ic_image"
            app:tint="#9E9E9E"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tv_update_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 设置面板（默认隐藏；展开时设计内容全部展示——面板高度自适应 wrap_content，
         不再与正文按 4:6 分屏；正文区收缩让位，预览与全部设置项同时可见；与便签编辑页同款） -->
    <LinearLayout
        android:id="@+id/style_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 预览文本：置顶固定（不随设置项滚动） -->
        <TextView
            android:id="@+id/preview_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:padding="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:text="小部件预览示例"
            android:textSize="14sp"
            android:textColor="#333333"
            android:background="@color/note_default_bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

                <!-- 颜色行：字体颜色 → 边框颜色 → 背景颜色 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="字体颜色"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_marginEnd="12dp" />
                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scrollbars="none">
                        <LinearLayout
                            android:id="@+id/font_swatches"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="3dp" />
                    </HorizontalScrollView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="边框颜色"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_marginEnd="12dp" />
                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scrollbars="none">
                        <LinearLayout
                            android:id="@+id/border_swatches"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="3dp" />
                    </HorizontalScrollView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="背景颜色"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_marginEnd="12dp" />
                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scrollbars="none">
                        <LinearLayout
                            android:id="@+id/bg_swatches"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="3dp" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- 背景照片：小部件背景可用相册照片；与背景颜色叠加（选“无背景色”即纯照片） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="背景照片"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_marginEnd="12dp" />
                    <Button
                        android:id="@+id/btn_bg_photo"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:textSize="13sp"
                        android:textColor="#37474F"
                        android:text="从相册选择" />
                    <Button
                        android:id="@+id/btn_bg_photo_clear"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:textSize="13sp"
                        android:textColor="#37474F"
                        android:text="清除"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView style="@style/SectionLabel" android:text="背景不透明度（0% = 全透明）" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <SeekBar
                        android:id="@+id/seek_alpha"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="100" />
                    <TextView
                        android:id="@+id/tv_alpha"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:gravity="end" />
                </LinearLayout>

                <!-- 排：水平对齐 | 字体大小 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical">
                        <TextView style="@style/RowLabel" android:text="水平对齐" />
                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/group_align_h"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:selectionRequired="true">
                            <Button android:id="@+id/btn_align_hl" style="@style/ModeButton"
                                android:text="" app:icon="@drawable/ic_align_left"
                                app:iconGravity="textStart" app:iconPadding="0dp"
                                app:iconSize="18dp" android:contentDescription="左对齐" />
                            <Button android:id="@+id/btn_align_hc" style="@style/ModeButton"
                                android:text="" app:icon="@drawable/ic_align_center"
                                app:iconGravity="textStart" app:iconPadding="0dp"
                                app:iconSize="18dp" android:contentDescription="水平居中" />
                            <Button android:id="@+id/btn_align_hr" style="@style/ModeButton"
                                android:text="" app:icon="@drawable/ic_align_right"
                                app:iconGravity="textStart" app:iconPadding="0dp"
                                app:iconSize="18dp" android:contentDescription="右对齐" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/RowLabel" android:text="字体大小" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <Button
                                android:id="@+id/btn_size_minus"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="40dp"
                                android:layout_height="36dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="−"
                                android:textSize="20sp"
                                android:textColor="#424242" />
                            <TextView
                                android:id="@+id/tv_size"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="14sp"
                                android:textSize="15sp" />
                            <Button
                                android:id="@+id/btn_size_plus"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="40dp"
                                android:layout_height="36dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="＋"
                                android:textSize="20sp"
                                android:textColor="#424242" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 排：垂直对齐 | 字体效果 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical">
                        <TextView style="@style/RowLabel" android:text="垂直对齐" />
                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/group_align_v"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:selectionRequired="true">
                            <Button android:id="@+id/btn_align_vt" style="@style/ModeButton"
                                android:text="" app:icon="@drawable/ic_align_top"
                                app:iconGravity="textStart" app:iconPadding="0dp"
                                app:iconSize="18dp" android:contentDescription="顶对齐" />
                            <Button android:id="@+id/btn_align_vc" style="@style/ModeButton"
                                android:text="" app:icon="@drawable/ic_align_middle"
                                app:iconGravity="textStart" app:iconPadding="0dp"
                                app:iconSize="18dp" android:contentDescription="垂直居中" />
                            <Button android:id="@+id/btn_align_vb" style="@style/ModeButton"
                                android:text="" app:icon="@drawable/ic_align_bottom"
                                app:iconGravity="textStart" app:iconPadding="0dp"
                                app:iconSize="18dp" android:contentDescription="底对齐" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/RowLabel" android:text="字体效果" />
                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/toggle_bold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:singleSelection="false"
                            app:selectionRequired="false">
                            <Button android:id="@+id/btn_bold" style="@style/ModeButton"
                                android:text="" app:icon="@drawable/ic_eff_bold"
                                app:iconGravity="textStart" app:iconPadding="0dp"
                                app:iconSize="18dp" android:contentDescription="加粗" />
                            <Button android:id="@+id/btn_italic" style="@style/ModeButton"
                                android:text="" app:icon="@drawable/ic_eff_italic"
                                app:iconGravity="textStart" app:iconPadding="0dp"
                                app:iconSize="18dp" android:contentDescription="斜体" />
                            <Button android:id="@+id/btn_underline" style="@style/ModeButton"
                                android:text="" app:icon="@drawable/ic_eff_underline"
                                app:iconGravity="textStart" app:iconPadding="0dp"
                                app:iconSize="18dp" android:contentDescription="下划线" />
                            <Button android:id="@+id/btn_shadow" style="@style/ModeButton"
                                android:text="" app:icon="@drawable/ic_eff_shadow"
                                app:iconGravity="textStart" app:iconPadding="0dp"
                                app:iconSize="18dp" android:contentDescription="投影" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </LinearLayout>
                </LinearLayout>

                <!-- 排：滚动显示 | 置顶 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <CheckBox
                        android:id="@+id/chk_scroll"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="38dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:textSize="13sp"
                        android:text="内容超出后滚动显示" />
                    <CheckBox
                        android:id="@+id/chk_pin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="38dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:textSize="13sp"
                        android:text="置顶" />
                </LinearLayout>

                <!-- 将当前样式保存为默认样式：全称按钮，面板最底部 -->
                <Button
                    android:id="@+id/btn_set_default"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:minHeight="38dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginTop="10dp"
                    android:textSize="13sp"
                    android:textColor="#37474F"
                    android:text="将当前样式设置为默认" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部操作行（固定屏幕最底部）：删除 | 设置小部件 | 保存 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btn_delete"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:maxLines="1"
            android:text="删除"
            android:textColor="@color/error_red"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_widget_design"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:maxLines="1"
            android:strokeColor="#E0E0E0"
            android:text="设置小部件"
            android:textColor="#212121"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_save"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:maxLines="1"
            android:text="保存"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
