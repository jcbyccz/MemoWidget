<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:navigationIcon="@drawable/ic_back"
        app:title="设置"
        app:titleTextColor="@color/toolbar_text" />

    <!-- 设置内容超出一屏后可滚动（Toolbar 与回收站入口固定） -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="32dp">

        <!-- 应用图标：与桌面启动图标一致，圆形蒙版还原桌面观感 -->
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="应用图标"
            android:src="@mipmap/ic_launcher"
            app:shapeAppearanceOverlay="@style/CircleImage" />

        <TextView
            android:id="@+id/tv_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="正闲拾笺"
            android:textColor="#212121"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#757575"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- 应用介绍：标题行右侧放隐藏签名，颜色与背景（colorSurface）一致 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/SettingItemLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="应用介绍" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="4dp"
                android:text="作者：jcbyccz"
                android:textColor="@color/author_sig"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="为桌面小部件设计的便签，数据仅保存在本机。"
            android:textColor="#424242"
            android:textSize="14sp" />

        <TextView style="@style/SettingItemLabel" android:text="主题色" />
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/swatch_theme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp" />
        </HorizontalScrollView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="工具栏与整体风格使用所选颜色，文字自动适配深浅；选择后立即生效。"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <!-- 备份与恢复：导出 / 导入 / 从自动备份恢复 -->
        <TextView style="@style/SettingItemLabel" android:text="备份与恢复" />

        <LinearLayout
            android:id="@+id/btn_backup_export"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="导出便签"
                android:textColor="#212121"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_backup_import"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="导入便签"
                android:textColor="#212121"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_backup_restore"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="从自动备份恢复"
                android:textColor="#212121"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="从最近一次自动备份中恢复便签。"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <!-- 自动备份：间隔可选 1/3/7/30/999 天，应用启动时检查 -->
        <TextView style="@style/SettingItemLabel" android:text="自动备份" />

        <LinearLayout
            android:id="@+id/btn_backup_interval"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="备份时间间隔"
                android:textColor="#212121"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_backup_interval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#757575"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="到达设定间隔后，打开应用时自动备份一次便签，保留最近 10 份。"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <!-- 最近备份状态：让自动备份可见可感知 -->
        <TextView
            android:id="@+id/tv_backup_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />
    </LinearLayout>
    </LinearLayout>
    </ScrollView>

    <!-- 底部回收站入口：图标与回收站页右上角一致，点击进入回收站 -->
    <LinearLayout
        android:id="@+id/btn_recycle_entry"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="?android:attr/selectableItemBackground">

        <ImageView
            android:id="@+id/ic_recycle_entry"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_delete"
            app:tint="#757575" />

        <TextView
            android:id="@+id/tv_recycle_entry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="回收站"
            android:textColor="#757575"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>