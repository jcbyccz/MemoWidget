<?xml version="1.0" encoding="utf-8"?>
<!-- 标题视图：单列扁平行，只显示标题（无正文/条目预览），
     保留底行元素：置顶标记、待办几分之几、时间。
     root 用 MaterialCardView 与卡片布局同构：批量选中灰底、样式背景边框逻辑可完整复用 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:minHeight="52dp"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@null"
    app:cardBackgroundColor="@color/note_default_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:rippleColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- 批量选择复选框（默认隐藏，多选模式显示） -->
        <TextView
            android:id="@+id/item_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_check_hollow"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:visibility="gone"
            android:contentDescription="选择" />

        <!-- 待办图标（仅待办行显示，代码控制） -->
        <ImageView
            android:id="@+id/item_todo_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="待办"
            android:src="@drawable/ic_todo_add"
            android:visibility="gone" />

        <!-- 标题（单行截断，样式由 TextStyler 应用） -->
        <TextView
            android:id="@+id/item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 置顶标记 -->
        <TextView
            android:id="@+id/item_pin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pin_label"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="置顶"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 已完成/总项数（仅待办行显示） -->
        <TextView
            android:id="@+id/item_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#9E9E9E"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 时间 -->
        <TextView
            android:id="@+id/item_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:maxLines="1"
            android:textColor="#9E6D4C41"
            android:textSize="11sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
